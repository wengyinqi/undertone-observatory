{
  "name": "undertone-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual signal observatory powered by TypeSafe Jev.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run check && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run check:app && npm run check:server",
    "check:app": "tsc -p tsconfig.app.json --pretty false",
    "check:server": "tsc -p tsconfig.server.json --pretty false"
  },
  "dependencies": {
    "dotenv": "18.0.2",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
